rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserDoc() && userDoc().data.role != null
          ? userDoc().data.role
          : 'employee';
    }

    function isAdmin() {
      return signedIn() && (
        role() == 'admin'
        || role() == 'ADMIN'
        || role() == 'partialAdmin'
        || role() == 'partial_admin'
        || role() == 'PARTIAL_ADMIN'
      );
    }

    function isFullAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'ADMIN');
    }

    function canApproveLeave() {
      return isFullAdmin()
        || (isAdmin()
          && (userDoc().data.canApproveLeave == true
            || (userDoc().data.permissions != null
              && userDoc().data.permissions.approveLeave == true)));
    }

    function canManageSalary() {
      return isFullAdmin()
        || (isAdmin()
          && (userDoc().data.canManageSalary == true
            || (userDoc().data.permissions != null
              && userDoc().data.permissions.manageSalary == true)));
    }

    function employeeId() {
      return hasUserDoc() ? userDoc().data.employeeId : null;
    }

    function ownsEmployee(employeeIdValue) {
      return signedIn() && employeeId() == employeeIdValue;
    }

    function teamId() {
      return hasUserDoc() ? userDoc().data.teamId : null;
    }

    function sameTeam(teamIdValue) {
      return signedIn() && teamId() == teamIdValue;
    }

    function attendanceEmployeeUpdateKeys() {
      return [
        'attendanceStatus',
        'dayStatus',
        'sessionStatus',
        'logoutReason',
        'logoutAt',
        'logoutAtIst',
        'totalMinutes',
        'officeMinutes',
        'breakMinutes',
        'segments',
        'logoutLocation',
        'lastOfficeExitAtIst',
        'lastOfficeDistanceMeters',
        'currentBreakStartedAtIst',
        'currentBreakDistanceMeters',
        'lastOfficeEntryAtIst',
        'lastOfficeDistanceMeters',
        'lastBreakMinutes',
        'breakConsiderationRequired',
        'breakConsiderationStatus',
        'breakConsiderationReason',
        'breakConsiderationRequestedAt',
        'breakConsiderationRequestedAtIst',
        'lastPresenceCheckAt',
        'lastPresenceCheckAtIst',
        'lastPresenceCheckSource',
        'lastPresenceDistanceMeters',
        'lastPresenceInsideOffice',
        'faceImageBase64',
        'faceImageContentType',
        'faceImagePurgedAt',
        'faceImagePurgedAtIst',
        'updatedAt',
        'updatedAtIst',
        'logs'
      ];
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isFullAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.role in [
            'employee',
            'admin',
            'partialAdmin'
          ]);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.employeeId == resource.data.employeeId
        && (isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'displayName',
            'nickName',
            'email',
            'updatedAt',
            'fcmToken',
            'fcmUpdatedAt'
          ]));
      allow delete: if false;
    }

    match /employee_profiles/{employeeIdValue} {
      allow read: if ownsEmployee(employeeIdValue) || isAdmin();
      allow create: if isAdmin()
        || (ownsEmployee(employeeIdValue)
          && request.resource.data.employeeId == employeeIdValue);
      allow update: if isAdmin()
        || (ownsEmployee(employeeIdValue)
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nickName',
            'firstName',
            'lastName',
            'employeeName',
            'dateOfBirth',
            'contactNumber',
            'email',
            'updatedAt',
            'updatedAtIst'
          ]));
      allow delete: if isAdmin();
    }

    match /teams/{teamIdValue} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId()
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(attendanceEmployeeUpdateKeys()));
      allow delete: if isAdmin();
    }

    match /attendance_consideration_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId()
        && request.resource.data.status == 'requested';
      allow update, delete: if isAdmin();
    }

    match /attendance_records/{attendanceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.employeeId == employeeId()
          && request.resource.data.employeeId == resource.data.employeeId);
      allow delete: if isAdmin();
    }

    match /attendance_summaries/{summaryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create, update, delete: if isAdmin();
    }

    match /team_attendance_summaries/{summaryId} {
      allow read: if isAdmin() || sameTeam(resource.data.teamId);
      allow create, update, delete: if isAdmin();
    }

    match /leave_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if canApproveLeave()
        || (signedIn() && resource.data.employeeId == employeeId()
          && request.resource.data.employeeId == resource.data.employeeId
          && resource.data.status in ['requested_leave', 'rejected']);
      allow delete: if canApproveLeave();
    }

    match /attendance_mark_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update, delete: if isAdmin();
    }

    match /salary_records/{recordId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create, update: if canManageSalary();
      allow delete: if canManageSalary();
    }

    match /salary_structures/{employeeIdValue} {
      allow read: if isAdmin() || ownsEmployee(employeeIdValue);
      allow create, update, delete: if canManageSalary();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.assignedToEmployeeId == employeeId());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.assignedToEmployeeId == employeeId()
          && request.resource.data.assignedToEmployeeId == resource.data.assignedToEmployeeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'latestScrumSummary',
            'latestBlocker',
            'latestHours',
            'scrumReports',
            'updatedAt',
            'updatedAtIst'
          ]));
    }

    match /exit_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /team_messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /fcm_outbox/{messageId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.senderUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /notification_inbox/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /notification_reads/{readId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.recipientUid == request.auth.uid
          || resource.data.employeeId == employeeId()
          || resource.data.teamId == teamId()
          || resource.data.targetType == 'all'
        ));
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /company_documents/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /holidays/{dateKey} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /fcm_background_events/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    function appUserDoc(appId) {
      return get(/databases/$(database)/documents/Attendance/$(appId)/users/$(request.auth.uid));
    }

    function hasAppUserDoc(appId) {
      return signedIn()
        && exists(/databases/$(database)/documents/Attendance/$(appId)/users/$(request.auth.uid));
    }

    function appRole(appId) {
      return hasAppUserDoc(appId) && appUserDoc(appId).data.role != null
          ? appUserDoc(appId).data.role
          : 'employee';
    }

    function appIsAdmin(appId) {
      return signedIn() && (
        appRole(appId) == 'admin'
        || appRole(appId) == 'ADMIN'
        || appRole(appId) == 'partialAdmin'
        || appRole(appId) == 'partial_admin'
        || appRole(appId) == 'PARTIAL_ADMIN'
      );
    }

    function appIsFullAdmin(appId) {
      return signedIn() && (
        appRole(appId) == 'admin'
        || appRole(appId) == 'ADMIN'
      );
    }

    function appCanApproveLeave(appId) {
      return appIsFullAdmin(appId)
        || (appIsAdmin(appId)
          && (appUserDoc(appId).data.canApproveLeave == true
            || (appUserDoc(appId).data.permissions != null
              && appUserDoc(appId).data.permissions.approveLeave == true)));
    }

    function appCanManageSalary(appId) {
      return appIsFullAdmin(appId)
        || (appIsAdmin(appId)
          && (appUserDoc(appId).data.canManageSalary == true
            || (appUserDoc(appId).data.permissions != null
              && appUserDoc(appId).data.permissions.manageSalary == true)));
    }

    function appEmployeeId(appId) {
      return hasAppUserDoc(appId) ? appUserDoc(appId).data.employeeId : null;
    }

    function appTeamId(appId) {
      return hasAppUserDoc(appId) ? appUserDoc(appId).data.teamId : null;
    }

    function appOwnsEmployee(appId, employeeIdValue) {
      return signedIn() && appEmployeeId(appId) == employeeIdValue;
    }

    match /Attendance/{appId} {
      allow read: if signedIn();
      allow create, update, delete: if appIsAdmin(appId);

      match /users/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || appIsAdmin(appId));
        allow create: if appIsFullAdmin(appId)
          || (signedIn() && request.auth.uid == uid
            && request.resource.data.role in [
              'employee',
              'admin',
              'partialAdmin'
            ]);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.employeeId == resource.data.employeeId
          && (appIsAdmin(appId)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'firstName',
              'lastName',
              'displayName',
              'nickName',
              'email',
              'updatedAt',
              'fcmToken',
              'fcmUpdatedAt',
              'teamId'
            ]));
        allow delete: if false;
      }

      match /employee_profiles/{employeeIdValue} {
        allow read: if appOwnsEmployee(appId, employeeIdValue) || appIsAdmin(appId);
        allow create: if appIsAdmin(appId)
          || (appOwnsEmployee(appId, employeeIdValue)
            && request.resource.data.employeeId == employeeIdValue);
        allow update: if appIsAdmin(appId)
          || (appOwnsEmployee(appId, employeeIdValue)
            && request.resource.data.employeeId == resource.data.employeeId);
        allow delete: if appIsAdmin(appId);
      }

      match /teams/{teamIdValue} {
        allow read: if signedIn();
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /attendance/{attendanceId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create: if signedIn()
          && request.resource.data.employeeId == appEmployeeId(appId);
        allow update: if appCanApproveLeave(appId)
          || (signedIn()
            && resource.data.employeeId == appEmployeeId(appId)
            && request.resource.data.employeeId == resource.data.employeeId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(attendanceEmployeeUpdateKeys()));
        allow delete: if appCanApproveLeave(appId);
      }

      match /attendance_consideration_requests/{requestId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create: if signedIn()
          && request.resource.data.employeeId == appEmployeeId(appId)
          && request.resource.data.status == 'requested';
        allow update, delete: if appIsAdmin(appId);
      }

      match /attendance_records/{attendanceId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create: if signedIn()
          && request.resource.data.employeeId == appEmployeeId(appId);
        allow update: if appIsAdmin(appId)
          || (signedIn()
            && resource.data.employeeId == appEmployeeId(appId)
            && request.resource.data.employeeId == resource.data.employeeId);
        allow delete: if appIsAdmin(appId);
      }

      match /attendance_summaries/{summaryId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /team_attendance_summaries/{summaryId} {
        allow read: if appIsAdmin(appId) || resource.data.teamId == appTeamId(appId);
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /leave_requests/{requestId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create: if signedIn()
          && request.resource.data.employeeId == appEmployeeId(appId);
        allow update: if appIsAdmin(appId)
          || (signedIn()
            && resource.data.employeeId == appEmployeeId(appId)
            && request.resource.data.employeeId == resource.data.employeeId);
        allow delete: if appIsAdmin(appId);
      }

      match /attendance_mark_requests/{requestId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create: if signedIn()
          && request.resource.data.employeeId == appEmployeeId(appId);
        allow update, delete: if appIsAdmin(appId);
      }

      match /salary_records/{recordId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create, update, delete: if appCanManageSalary(appId);
      }

      match /salary_structures/{employeeIdValue} {
        allow read: if appIsAdmin(appId) || appOwnsEmployee(appId, employeeIdValue);
        allow create, update, delete: if appCanManageSalary(appId);
      }

      match /tasks/{taskId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.assignedToEmployeeId == appEmployeeId(appId));
        allow create, delete: if appIsAdmin(appId);
        allow update: if appIsAdmin(appId)
          || (signedIn()
            && resource.data.assignedToEmployeeId == appEmployeeId(appId)
            && request.resource.data.assignedToEmployeeId == resource.data.assignedToEmployeeId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'latestScrumSummary',
              'latestBlocker',
              'latestHours',
              'scrumReports',
              'updatedAt',
              'updatedAtIst'
            ]));
      }

      match /exit_requests/{requestId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.employeeId == appEmployeeId(appId));
        allow create: if signedIn()
          && request.resource.data.employeeId == appEmployeeId(appId);
        allow update, delete: if appIsAdmin(appId);
      }

      match /team_messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if appIsAdmin(appId);
      }

      match /fcm_outbox/{messageId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && resource.data.senderUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if appIsAdmin(appId);
      }

      match /fcm_tokens/{tokenId} {
        allow read: if appIsAdmin(appId);
        allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if appIsAdmin(appId)
          || (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /notification_inbox/{notificationId} {
        allow read, update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
      }

      match /notification_reads/{readId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow create, update: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /notifications/{notificationId} {
        allow read: if appIsAdmin(appId)
          || (signedIn() && (
            resource.data.recipientUid == request.auth.uid
            || resource.data.employeeId == appEmployeeId(appId)
            || resource.data.teamId == appTeamId(appId)
            || resource.data.targetType == 'all'
          ));
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /announcements/{announcementId} {
        allow read: if signedIn();
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /company_documents/{documentId} {
        allow read: if signedIn();
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /holidays/{dateKey} {
        allow read: if signedIn();
        allow create, update, delete: if appIsAdmin(appId);
      }

      match /audit_logs/{logId} {
        allow read: if appIsAdmin(appId);
        allow create: if signedIn();
        allow update, delete: if false;
      }

      match /fcm_background_events/{eventId} {
        allow read: if appIsAdmin(appId);
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
