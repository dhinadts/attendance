rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasUserDoc() && userDoc().data.role != null
          ? userDoc().data.role
          : 'employee';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function employeeId() {
      return hasUserDoc() ? userDoc().data.employeeId : null;
    }

    function ownsEmployee(employeeIdValue) {
      return signedIn() && employeeId() == employeeIdValue;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'employee';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.employeeId == resource.data.employeeId
        && (isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'displayName',
            'nickName',
            'email',
            'updatedAt',
            'fcmToken',
            'fcmUpdatedAt'
          ]));
      allow delete: if false;
    }

    match /employee_profiles/{employeeIdValue} {
      allow read: if ownsEmployee(employeeIdValue) || isAdmin();
      allow create: if isAdmin()
        || (ownsEmployee(employeeIdValue)
          && request.resource.data.employeeId == employeeIdValue);
      allow update: if isAdmin()
        || (ownsEmployee(employeeIdValue)
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nickName',
            'firstName',
            'lastName',
            'employeeName',
            'dateOfBirth',
            'contactNumber',
            'email',
            'updatedAt',
            'updatedAtIst'
          ]));
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId()
          && request.resource.data.employeeId == resource.data.employeeId);
      allow delete: if isAdmin();
    }

    match /leave_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId()
          && request.resource.data.employeeId == resource.data.employeeId
          && resource.data.status in ['requested_leave', 'rejected']);
      allow delete: if isAdmin();
    }

    match /attendance_mark_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update, delete: if isAdmin();
    }

    match /salary_records/{recordId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /exit_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.employeeId == employeeId());
      allow create: if signedIn()
        && request.resource.data.employeeId == employeeId();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /team_messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /fcm_outbox/{messageId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.senderUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /notification_inbox/{notificationId} {
      allow read, update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /notification_reads/{readId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /fcm_background_events/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
