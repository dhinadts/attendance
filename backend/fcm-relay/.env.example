PORT=8080
FIREBASE_PROJECT_ID=your-firebase-project-id
BACKEND_API_KEY=change-this-long-random-api-key
# Local development only. Do not enable this in production.
ALLOW_UNAUTHENTICATED_BACKEND_API=false

# Recommended for Render/Railway:
# Paste the full Firebase service account JSON into this variable.
# Keep it in the hosting provider environment settings only.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id"}

# Alternative:
# Put a base64 encoded service account JSON here.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Use true to test Firestore processing without actually sending FCM.
FCM_RELAY_DRY_RUN=false

# Retry, monitoring, and status endpoints.
FCM_OUTBOX_LIMIT=25
FCM_MAX_RETRY_ATTEMPTS=5
FCM_BACKOFF_BASE_SECONDS=30
FCM_MAX_BACKOFF_SECONDS=86400
FCM_METRICS_ENABLED=true

# Firestore namespace used by the Flutter app.
FIRESTORE_APP_ROOT_COLLECTION=Attendance
FIRESTORE_APP_ROOT_DOCUMENT=main
